#include "corne_cirque.dtsi"

&kscan0 {
    col-gpios
        = <&pro_micro 21 GPIO_ACTIVE_HIGH>
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        ;
};

&glidepoint_listener {
    status = "okay";
    
    /* Opcional: Procesadores de entrada adicionales en el lado central.
       Por ejemplo, un escalador para ajustar la velocidad del cursor globalmente
       independientemente de qué lado venga la señal. */
    /* input-processors = <&zip_temp_layer 1 1000>;  Ejemplo: Capa temporal al mover */
};